apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend-app-deployment
  namespace: pod
  labels:
    app: frontend-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend-app
  template:
    metadata:
      labels:
        app: frontend-app
    spec:
      containers:
        - name: frontend-app
          image: sunilkumar83/frontend-app:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 80

